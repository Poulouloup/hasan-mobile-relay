# Keystore de signature (ne jamais commiter)
*.jks
*.keystore

# Instructions Claude Code (internes)
.claude/
.security/

# Knowledge graph graphify (généré, régénérable via /graphify . --update)
graphify-out/

# Tests manuels (locaux)
tests/
